{
  "name": "markdown-to-pdf",
  "version": "1.0.0",
  "description": "Fast Markdown to PDF converter with Mermaid and Math support",
  "main": "dist/index.js",
  "bin": {
    "md2pdf": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
